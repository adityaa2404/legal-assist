FROM python:3.11-slim

WORKDIR /app

# System dependencies for OCR and WeasyPrint HTML-to-PDF rendering.
RUN apt-get update && apt-get install -y \
    build-essential gcc libgl1 libglib2.0-0 \
    libcairo2 libpango-1.0-0 libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 libffi-dev shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-worker.txt .
RUN pip install --no-cache-dir -r requirements-worker.txt

# Fail the image build rather than a live worker task if a system dependency is absent.
RUN python -c "from weasyprint import HTML; print('WeasyPrint OK')"

# Pre-download EasyOCR models at build time — the container has no persistent
# storage, so without this every cold start re-downloads the detector +
# recognition models from scratch (minutes of delay on first OCR job).
# Covers en + hi (most common case per _LANG_MAP); other languages still
# download lazily on first use of that language.
RUN python -c "import easyocr; easyocr.Reader(['hi', 'en'], gpu=False)"

COPY ./app ./app

# Add a non-root user for security
RUN useradd -m appuser && chown -R appuser:appuser /app \
    && cp -r /root/.EasyOCR /home/appuser/.EasyOCR \
    && chown -R appuser:appuser /home/appuser/.EasyOCR
USER appuser
ENV HOME=/home/appuser

ENV PORT=7860
EXPOSE 7860

CMD ["python", "app/worker_entry.py"]
