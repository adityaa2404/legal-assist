@startuml Legal Assist - Chat Flow (Hybrid RAG)

!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Inter
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #64748B
skinparam sequenceParticipantBackgroundColor #F8FAFC
skinparam sequenceLifeLineBorderColor #94A3B8

title **Chat Flow** — Query Understanding + 3-Tier Hybrid RAG

actor "Client" as Client #E0F2FE
participant "ChatRouter\n«/chat»" as Router #DBEAFE
participant "PIIAnonymizer\n«Presidio»" as PII #E8F5E9
participant "BM25Search\n«keyword, local»" as BM25 #E8F5E9
participant "TreeSearch\n«LLM reasoning»" as Tree #E8F5E9
participant "SessionService" as Session #E8F5E9
participant "GeminiClient" as Gemini #FEE2E2
database "MongoDB" as DB #FEE2E2

== Upload time (once per document, not per question) ==

note over Gemini #FFF8E1
  **1 Gemini call per document**, made in the background
  right after upload/OCR/PII: builds the **HTOC tree**
  (hierarchical table of contents mapped to page ranges).
  This tree is what Tier 2 below searches — it is
  NOT rebuilt per chat message.
end note

== POST /api/v1/chat ==

Client -> Router : POST {message, history[]}\n+ X-Session-ID header
activate Router

Router -> Session : get(session_id)
Session -> DB : FIND session
DB --> Session : session (text, htoc_tree, bm25_data, pii_mapping)
Session --> Router : Session

alt htoc_status = "processing" AND no text yet
    Router --> Client : **202** "Document still being processed"
end

== Step 1: Anonymize ==

Router -> PII : anonymize(user_message + history)
PII --> Router : anon_question, anon_history

== Step 2: Cache check ==

Router -> Router : query_hash = md5(session_id + anon_question)
Router -> Session : get_cached_chat(session_id, hash)
Session -> DB : FIND chat_cache.{hash}

alt Cache HIT
    Session --> Router : cached {response, source_sections}
    Router -> PII : deanonymize(response)
    Router --> Client : **200** ChatResponse «cached, no LLM call»
end

== Step 3: Trim history ==

Router -> Router : _trim_history(anon_history)\nwalk backwards, keep msgs within\n24,000-char budget; older turns\ncollapsed to 1 summary line

== Step 4: Query Understanding — 1 Gemini call, every question ==

Router -> Gemini : generate_json(query understanding prompt)
activate Gemini
note right of Gemini #FFF8E1
  temp=0, ~500ms. Replaces the old separate
  intent-classifier + embedding calls.
end note
Gemini --> Router : {intent: exhaustive|comparative|targeted,\nexpanded_query: query + legal synonyms,\nkey_terms: [2-4 priority tokens]}
deactivate Gemini

note right of Router #E8F5E9
  If this call throws, falls back to
  {intent: "targeted", expanded_query: original\nquestion, key_terms: []} — never blocks chat.
end note

== Step 5: 3-Tier Retrieval ==

alt BM25 index exists (session.bm25_data present, or built on-the-fly if page_texts exist)

    == Tier 1 — BM25 (local, no LLM, ~5ms) ==
    Router -> BM25 : search(expanded_query, page_texts,\nintent=intent, key_terms=key_terms)
    activate BM25
    BM25 -> BM25 : tokenize, BM25Okapi score chunks
    BM25 -> BM25 : boost by HTOC title/summary\noverlap (+3.0 / +1.5) and\nkey_term hits (+0.5 each)
    BM25 -> BM25 : confidence = high(>2.0) |\nmedium(>0.5) | low(<=0.5)
    BM25 --> Router : {context, source_sections, confidence}
    deactivate BM25

    alt confidence = "low" AND session.htoc_tree exists
        == Tier 2 — LLM tree search over the EXISTING HTOC tree ==
        note right of Router #FFF7ED
            No new tree is built here — this searches
            the tree from Step "Upload time" above.
        end note
        Router -> Tree : search(htoc_tree, search_query, page_texts)
        activate Tree
        Tree -> Gemini : generate_json(tree summaries + query)
        Gemini --> Tree : {selected_nodes[], reasoning}
        Tree -> Tree : extract page text for\nselected nodes, cap 50KB
        alt Tier 2 call succeeds
            Tree --> Router : {context, source_sections}
            Router -> Router : confidence := "medium"
        else Tier 2 call throws
            Tree --> Router : exception (caught)
            note right of Router #FEE2E2
                **Not** a path to full-text.
                Keeps the original Tier-1 BM25
                result, confidence stays "low".
            end note
        end
        deactivate Tree
    end

    Router -> Router : return (context, sections,\nconfidence, use_fulltext=**false**)

else No BM25 index at all yet (HTOC/BM25 still building in background)
    == Tier 3 — Full-text fallback ==
    note right of Router #FEE2E2
        Only reachable when retrieval has **nothing
        to search yet** — independent of whether
        Tier 1/2 above ran or failed.
    end note
    Router -> Router : return (None, [], "low", use_fulltext=**true**)
end

== Step 6: LLM answer ==

alt use_fulltext = true
    Router -> Gemini : chat(question, session.anonymized_text, history)
else has partial context (from Tier 1 or Tier 2)
    Router -> Gemini : chat_with_context(question, context, history, source_info)
end
activate Gemini
Gemini --> Router : response text
deactivate Gemini

== Step 7: De-anonymize & cache ==

Router -> PII : deanonymize(response, pii_mapping)
PII --> Router : final_response
Router ->> Session : **async** cache_chat_response(session_id, hash, response, sections)
Session -> DB : UPDATE chat_cache.{hash}

Router --> Client : **200** ChatResponse {response, source_sections[]}
deactivate Router

|||

== POST /api/v1/chat/stream (SSE) — identical Steps 1-5, Step 6 streams ==

Client -> Router : POST /chat/stream
activate Router
Router -> Router : Steps 1-5 (same as above)
Router --> Client : **event: sources**\n{source_sections, retrieval_confidence}

Router -> Gemini : chat_with_context_stream(...) or chat_stream(...)
activate Gemini
loop streaming tokens
    Gemini --> Router : text chunk
    Router -> Router : hold back partial PII tokens\n(regex \\[[A-Z_0-9]*$ )
    Router -> PII : deanonymize(safe chunk)
    Router --> Client : **event: token** {text: "..."}
end
Gemini --> Router : stream complete
deactivate Gemini

Router ->> Session : cache full response
Router --> Client : **event: done** {}
deactivate Router

@enduml
